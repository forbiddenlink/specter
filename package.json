{
  "name": "@purplegumdropz/specter",
  "version": "1.2.0",
  "description": "Give your codebase a voice. A Copilot CLI plugin that builds a knowledge graph and lets you talk to your code.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "specter": "dist/cli.js",
    "specter-mcp": "dist/index.js"
  },
  "files": [
    "dist/",
    "LICENSE",
    "README.md",
    "action.yml",
    "scripts/"
  ],
  "scripts": {
    "build": "tsc && cp -r src/dashboard/static dist/dashboard/",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "scan": "node dist/cli.js scan",
    "dashboard": "node dist/cli.js dashboard",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "docs": "typedoc",
    "prepare": "husky",
    "biome:check": "biome check .",
    "biome:fix": "biome check . --write",
    "biome:format": "biome format . --write",
    "test:watch": "vitest"
  },
  "keywords": [
    "copilot",
    "mcp",
    "codebase",
    "knowledge-graph",
    "ast",
    "code-analysis",
    "github-copilot-cli"
  ],
  "author": "Liz Stein",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/forbiddenlink/specter"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.18",
    "@anthropic-ai/sdk": "^0.106.0",
    "@fastify/cors": "^11.0.0",
    "@fastify/rate-limit": "^11.1.0",
    "@fastify/static": "^9.0.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@octokit/rest": "^22.0.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.78.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.220.0",
    "@opentelemetry/resources": "^2.6.1",
    "@opentelemetry/sdk-node": "^0.220.0",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "@types/qrcode": "^1.5.6",
    "canvas": "^3.2.1",
    "cfonts": "^3.3.1",
    "chalk": "^5.3.0",
    "chalk-animation": "^2.0.3",
    "chart.js": "^4.5.1",
    "commander": "^15.0.0",
    "fast-glob": "^3.3.3",
    "fastify": "^5.7.0",
    "gradient-string": "^3.0.0",
    "langfuse": "^3.38.20",
    "listr2": "^10.1.0",
    "log-update": "^8.0.0",
    "ora": "^9.0.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "qrcode": "^1.5.4",
    "simple-git": "^3.22.0",
    "terminal-link": "^5.0.0",
    "ts-morph": "^28.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.9",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/gradient-string": "^1.1.6",
    "@types/node": "^26.1.1",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.0.18",
    "concurrently": "^10.0.0",
    "husky": "^9.1.7",
    "jsdom": "^29.0.1",
    "lint-staged": "^17.0.7",
    "msw": "^2.12.14",
    "pino-test": "^2.0.0",
    "typedoc": "^0.28.0",
    "typescript": "^7.0.2",
    "vitest": "^4.0.18"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "biome check --write"
    ],
    "*.json": [
      "biome format --write"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "canvas"
    ],
    "overrides": {
      "minimatch": ">=9.0.7",
      "next": ">=16.2.3",
      "path-to-regexp": ">=8.4.0",
      "picomatch": "^4.0.4",
      "postcss": ">=8.5.23 <9",
      "rollup": ">=4.59.0",
      "vite": "8.0.16",
      "shell-quote": ">=1.8.4",
      "ws": ">=8.18.2",
      "@opentelemetry/exporter-prometheus": ">=0.217.0",
      "defu": ">=6.1.5",
      "serialize-javascript": ">=7.0.3",
      "flatted": ">=3.4.2",
      "lodash": "^4.18.1",
      "systeminformation": ">=5.31.6",
      "yaml": ">=2.8.3",
      "cookie": ">=0.7.0 <2.0.0",
      "protobufjs": "^7.5.8",
      "dompurify": ">=3.4.0",
      "fast-xml-parser": ">=5.7.0",
      "uuid": ">=14.0.0",
      "@protobufjs/utf8": ">=1.1.1",
      "basic-ftp": ">=5.3.1",
      "ip-address": ">=10.3.1 <11",
      "fast-xml-builder": ">=1.1.7",
      "@grpc/grpc-js": "^1.14.4",
      "brace-expansion@5": ">=5.0.8 <6",
      "@fastify/static@10": ">=10.1.2 <11",
      "shell-quote@1": ">=1.9.0 <2",
      "fast-uri@4": ">=4.1.1 <5",
      "@fastify/static": ">=10.1.2 <11",
      "brace-expansion": ">=5.0.8 <6",
      "fast-uri": ">=4.0.1 <5",
      "hono": ">=4.12.34 <5"
    }
  },
  "packageManager": "pnpm@10.32.1"
}
