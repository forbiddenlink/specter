{
  "name": "@purplegumdropz/specter",
  "version": "1.2.0",
  "description": "Give your codebase a voice. A Copilot CLI plugin that builds a knowledge graph and lets you talk to your code.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "specter": "dist/cli.js",
    "specter-mcp": "dist/index.js"
  },
  "files": [
    "dist/",
    "LICENSE",
    "README.md",
    "action.yml",
    "scripts/"
  ],
  "scripts": {
    "build": "tsc && cp -r src/dashboard/static dist/dashboard/",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "scan": "node dist/cli.js scan",
    "dashboard": "node dist/cli.js dashboard",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "docs": "typedoc",
    "prepare": "husky",
    "biome:check": "biome check .",
    "biome:fix": "biome check . --write",
    "biome:format": "biome format . --write",
    "test:watch": "vitest"
  },
  "keywords": [
    "copilot",
    "mcp",
    "codebase",
    "knowledge-graph",
    "ast",
    "code-analysis",
    "github-copilot-cli"
  ],
  "author": "Liz Stein",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/forbiddenlink/specter"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.55",
    "@anthropic-ai/sdk": "^0.78.0",
    "@fastify/cors": "^11.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^9.0.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@octokit/rest": "^22.0.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.72.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.214.0",
    "@opentelemetry/resources": "^2.6.1",
    "@opentelemetry/sdk-node": "^0.214.0",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "@types/qrcode": "^1.5.6",
    "canvas": "^3.2.1",
    "cfonts": "^3.3.1",
    "chalk": "^5.3.0",
    "chalk-animation": "^2.0.3",
    "chart.js": "^4.5.1",
    "commander": "^14.0.0",
    "fast-glob": "^3.3.3",
    "fastify": "^5.7.0",
    "gradient-string": "^3.0.0",
    "langfuse": "^3.38.20",
    "listr2": "^10.1.0",
    "log-update": "^7.1.0",
    "ora": "^9.0.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "qrcode": "^1.5.4",
    "simple-git": "^3.22.0",
    "terminal-link": "^5.0.0",
    "ts-morph": "^27.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.9",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/gradient-string": "^1.1.6",
    "@types/node": "^22.15.21",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.0.18",
    "concurrently": "^9.2.1",
    "husky": "^9.1.7",
    "jsdom": "^29.0.1",
    "lint-staged": "^16.2.7",
    "msw": "^2.12.14",
    "pino-test": "^2.0.0",
    "typedoc": "^0.28.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.18"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "biome check --write"
    ],
    "*.json": [
      "biome format --write"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "canvas"
    ],
    "overrides": {
      "minimatch": ">=9.0.7",
      "next": ">=16.2.3",
      "path-to-regexp": ">=8.4.0",
      "picomatch": ">=4.0.4",
      "postcss": ">=8.5.3",
      "rollup": ">=4.59.0",
      "vite": ">=6.4.2",
      "ws": ">=8.18.2"
    }
  }
}
