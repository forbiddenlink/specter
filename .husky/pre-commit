# Global secret-scanning gate (gitleaks/zizmor/vale) — husky's local
# core.hooksPath (.husky/_) bypasses ~/.git-hooks, so invoke it explicitly.
# Added 2026-09-23 after a fleet-wide audit found this gap in 19 repos.
if [ -x "$HOME/.git-hooks/pre-commit" ]; then
  "$HOME/.git-hooks/pre-commit" || exit 1
fi

npx lint-staged
